# Copy to .env and fill in. Never commit .env. Read only by src/server/config.ts.
PORT=8787
DB_PATH=data/yui.db
DATA_DIR=data
# Set by deploy to the git commit
APP_VERSION=
# Cloudflare Access: require its identity header and allow only this account
REQUIRE_ACCESS=1
ALLOWED_EMAIL=
TURN_MODEL=claude-opus-5-5
GRADING_MODEL=claude-opus-5-5
# Locally only. On the VM the key comes from Secret Manager (yui-anthropic-key).
ANTHROPIC_API_KEY=
